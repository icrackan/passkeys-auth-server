# Copy this file to .env (do NOT commit the real .env with secrets)

# Base64-encoded Firebase service account JSON (use `cat serviceAccount.json | base64` to create)
FIREBASE_SERVICE_ACCOUNT=BASE64_ENCODED_SERVICE_ACCOUNT_JSON_HERE

# Realtime Database URL (or Firestore URL if you use firestore)
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Relying Party ID used by your WebAuthn config (optional)
RP_ID=auth.tomcolvin.co.uk
